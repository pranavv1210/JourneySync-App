{
  "headers": [
    {
      "source": "/journeysync.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"JourneySync-Beta.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/beta",
      "destination": "/index.html"
    },
    {
      "source": "/beta/(.*)",
      "destination": "/index.html"
    }
  ]
}
